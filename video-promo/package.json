{
  "name": "@eecc/video-promo",
  "version": "0.1.0",
  "private": true,
  "description": "Video promocional vertical (9:16, 50 s) de ATLAS hecho con Remotion. Se renderiza en local a ../out/video-promo/.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts PromoVertical ../out/video-promo/atlas-promo-9x16.mp4",
    "portada": "remotion still src/index.ts PromoVertical ../out/video-promo/portada.png --frame=1440",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.536",
    "@remotion/google-fonts": "4.0.536",
    "@remotion/transitions": "4.0.536",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.7.3"
  }
}
