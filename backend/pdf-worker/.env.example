# Copia este archivo como `.env` y ajusta los valores locales.
# No incluyas secretos reales aquí; este archivo se versiona.

# Directorio donde el worker publica los artefactos por trabajo.
EECC_WORKER_ARTIFACT_ROOT=artifacts

# Directorio para temporales del proceso; vacío usa el temporal del sistema.
EECC_WORKER_TEMPORARY_ROOT=

# Límite de tamaño del PDF de entrada, en bytes.
EECC_WORKER_MAX_PDF_BYTES=52428800

# Formatos de salida habilitados por defecto.
EECC_WORKER_EXPORT_XLSX=true
EECC_WORKER_EXPORT_CSV=true

# Estrategia usada cuando la petición no indica una.
EECC_WORKER_DEFAULT_EXTRACTOR_ID=

# Documentos procesados a la vez. Cada uno reparte sus páginas entre varios
# procesos, así que subirlo por encima de los núcleos disponibles ralentiza a todos.
EECC_WORKER_MAX_CONCURRENT_DOCUMENTS=2

# Cola interna del worker. En despliegue, la credencial llega por variable de entorno.
EECC_WORKER_CELERY_BROKER_URL=redis://127.0.0.1:6379/0
EECC_WORKER_CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
EECC_WORKER_CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=240
EECC_WORKER_CELERY_TASK_TIME_LIMIT_SECONDS=300
EECC_WORKER_CELERY_MAX_RETRIES=2
