// Implementa el modelo lógico de `docs/_base_de_datos.md`.
//
// Reglas que este esquema hace cumplir:
// - toda entidad de un tenant lleva `organizationId`, aunque pudiera derivarse;
// - las claves compuestas impiden asociar filas de organizaciones distintas;
// - no existe tabla de movimientos bancarios: el MVP aplica minimización de datos;
// - los importes persistidos usan `Decimal`, nunca coma flotante;
// - de una contraseña solo se guarda su derivación, nunca el valor en claro;
// - la sesión es un token opaco con fila propia, para poder revocarla al instante;
// - roles, permisos, membresías y sus funciones son catálogos, no enums: crecer es
//   insertar filas (ADR-0016).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum MembershipStatus {
  ACTIVE
  REVOKED
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

enum StatementStatus {
  REGISTERED
  UPLOADED
  PROCESSED
  DELETED
}

enum JobStatus {
  PENDING
  UPLOADED
  QUEUED
  PROCESSING
  SUCCEEDED
  NEEDS_REVIEW
  FAILED
}

enum JobAttemptStatus {
  RUNNING
  SUCCEEDED
  NEEDS_REVIEW
  FAILED
}

enum WarningSeverity {
  INFO
  WARNING
  ERROR
}

enum ArtifactKind {
  SOURCE_PDF
  RESULT_XLSX
  RESULT_CSV
  TECHNICAL_MANIFEST
}

model Organization {
  id            String             @id @default(uuid()) @db.Uuid
  displayName   String             @map("display_name") @db.VarChar(160)
  status        OrganizationStatus @default(ACTIVE)
  retentionDays Int                @default(90) @map("retention_days")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships OrganizationMembership[]
  sessions    Session[]
  apiKeys     ApiKey[]
  statements  Statement[]
  jobs        Job[]
  attempts    JobAttempt[]
  warnings    JobWarning[]
  artifacts   Artifact[]
  auditEvents AuditEvent[]

  @@map("organizations")
}

/// Persona que inicia sesión. El correo se guarda normalizado (minúsculas, sin
/// espacios) porque es la clave de acceso y no puede depender de cómo se escriba.
model User {
  id              String     @id @default(uuid()) @db.Uuid
  emailNormalized String     @unique @map("email_normalized") @db.VarChar(320)
  displayName     String     @map("display_name") @db.VarChar(160)
  /// Derivación scrypt con sal, en el formato de `password-hash.ts`. Nunca el valor
  /// en claro. Es opcional porque un usuario recién invitado aún no tiene contraseña.
  passwordHash    String?    @map("password_hash") @db.VarChar(255)
  passwordSetAt   DateTime?  @map("password_set_at") @db.Timestamptz(6)
  status          UserStatus @default(INVITED)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(6)
  /// Intentos fallidos consecutivos y bloqueo temporal: sin esto, la contraseña de
  /// cualquier persona se puede probar sin límite contra un endpoint público.
  failedAttempts  Int        @default(0) @map("failed_attempts")
  lockedUntil     DateTime?  @map("locked_until") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships OrganizationMembership[]
  statements  Statement[]
  sessions    Session[]

  @@map("users")
}

/// Sesión de navegador. Token opaco y no JWT: así cerrar sesión o desactivar a una
/// persona surte efecto de inmediato, sin esperar a que caduque nada firmado.
/// Solo se almacena el hash del token; el valor viaja en una cookie httpOnly.
model Session {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([organizationId, expiresAt])
  @@map("sessions")
}

/// Pertenencia de una persona a una organización: con qué rol y con qué membresía.
///
/// El rol dice qué puede **administrar**; la membresía (plan), qué parte del
/// producto **usa** y con qué límites. Son independientes: un administrador puede
/// tener cualquier membresía. Ver ADR-0016.
model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  roleCode       String           @map("role_code") @db.VarChar(32)
  planCode       String           @map("plan_code") @db.VarChar(32)
  /// Desde cuándo tiene la membresía actual. Los cambios quedan en `audit_events`.
  planChangedAt  DateTime         @default(now()) @map("plan_changed_at") @db.Timestamptz(6)
  /// Último día de vigencia, en la zona horaria del negocio. Nulo: no vence. Solo
  /// la llevan los roles con `plan_expiry_required`; vencida, no se convierte (ADR-0017).
  planExpiresOn  DateTime?        @map("plan_expires_on") @db.Date
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  // `Restrict`: un rol o un plan en uso no se borra del catálogo; se retira.
  role         Role           @relation(fields: [roleCode], references: [code], onDelete: Restrict)
  plan         MembershipPlan @relation(fields: [planCode], references: [code], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([planCode])
  @@map("organization_memberships")
}

/// Rol dentro de una organización. Es un catálogo y no un enum para que añadir un
/// rol sea insertar filas, no migrar un tipo. El código pregunta por **permisos**
/// (`role_permissions`) y por **rango**, nunca por el nombre de un rol (ADR-0016).
model Role {
  code               String   @id @db.VarChar(32)
  name               String   @db.VarChar(80)
  description        String   @db.VarChar(255)
  /// Jerarquía: solo se gestionan cuentas de rango inferior; con el mismo rango,
  /// solo cambios reversibles. Nadie asigna un rol de rango superior al suyo.
  rank               Int      @default(0)
  /// Plan que se propone al dar de alta con este rol. Nulo: hay que elegirlo.
  defaultPlanCode    String?  @map("default_plan_code") @db.VarChar(32)
  /// Si su membresía tiene fecha de vencimiento. Los administradores no vencen.
  planExpiryRequired Boolean  @default(false) @map("plan_expiry_required")
  /// Los roles sembrados por migración no se borran del catálogo.
  isSystem           Boolean  @default(false) @map("is_system")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  defaultPlan MembershipPlan?          @relation("RoleDefaultPlan", fields: [defaultPlanCode], references: [code], onDelete: SetNull)
  permissions RolePermission[]
  memberships OrganizationMembership[]

  @@map("roles")
}

/// Acción administrable que un rol concede. Solo existen las que el código aplica:
/// un permiso sin efecto haría creer que hay una restricción que no hay.
model Permission {
  code        String   @id @db.VarChar(64)
  description String   @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleCode       String @map("role_code") @db.VarChar(32)
  permissionCode String @map("permission_code") @db.VarChar(64)

  role       Role       @relation(fields: [roleCode], references: [code], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([roleCode, permissionCode])
  @@map("role_permissions")
}

/// Tipo de membresía: qué vistas usa una persona y con qué límites. Los límites son
/// columnas y no constantes del código para que un plan nuevo, o un cambio de cupo,
/// sea una fila y no un despliegue.
model MembershipPlan {
  code                  String   @id @db.VarChar(32)
  name                  String   @db.VarChar(80)
  description           String   @db.VarChar(255)
  /// Documentos que conserva cada persona; al superarlo elige cuál reemplazar
  /// (ADR-0007, ADR-0014).
  maxRetainedStatements Int      @map("max_retained_statements")
  /// Páginas admitidas por PDF. Nulo: sin límite.
  maxPagesPerDocument   Int?     @map("max_pages_per_document")
  /// Plan de las cuentas nuevas cuando no se indica otro.
  isDefault             Boolean  @default(false) @map("is_default")
  /// Un plan retirado no se ofrece en altas ni cambios; quien lo tiene lo conserva.
  isActive              Boolean  @default(true) @map("is_active")
  sortOrder             Int      @default(0) @map("sort_order")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  features        PlanFeature[]
  memberships     OrganizationMembership[]
  defaultForRoles Role[]                   @relation("RoleDefaultPlan")

  @@map("membership_plans")
}

/// Parte del producto que un plan habilita, además de convertir, que tienen todos.
model Feature {
  code        String   @id @db.VarChar(64)
  description String   @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  plans PlanFeature[]

  @@map("features")
}

model PlanFeature {
  planCode    String @map("plan_code") @db.VarChar(32)
  featureCode String @map("feature_code") @db.VarChar(64)

  plan    MembershipPlan @relation(fields: [planCode], references: [code], onDelete: Cascade)
  feature Feature        @relation(fields: [featureCode], references: [code], onDelete: Cascade)

  @@id([planCode, featureCode])
  @@map("plan_features")
}

/// Credencial de servicio con alcance de organización.
/// Solo se guarda el hash; el valor en claro se muestra una vez al crearla.
model ApiKey {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  label          String       @db.VarChar(80)
  tokenHash      String       @unique @map("token_hash") @db.VarChar(64)
  status         ApiKeyStatus @default(ACTIVE)
  lastUsedAt     DateTime?    @map("last_used_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("api_keys")
}

model Statement {
  id                 String          @id @default(uuid()) @db.Uuid
  organizationId     String          @map("organization_id") @db.Uuid
  uploadedById       String?         @map("uploaded_by") @db.Uuid
  contentFingerprint String          @map("content_fingerprint") @db.VarChar(64)
  /// Etiqueta privada para el dueño; nunca se usa como ruta ni se registra.
  sourceFileName     String?         @map("source_file_name") @db.VarChar(255)
  byteSize           Int             @map("byte_size")
  status             StatementStatus @default(REGISTERED)
  bankCode           String?         @map("bank_code") @db.VarChar(32)
  currencyCode       String?         @map("currency_code") @db.Char(3)
  periodStart        DateTime?       @map("period_start") @db.Date
  periodEnd          DateTime?       @map("period_end") @db.Date
  accountAlias       String?         @map("account_alias") @db.VarChar(32)
  retainUntil        DateTime?       @map("retain_until") @db.Timestamptz(6)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  jobs         Job[]
  artifacts    Artifact[]

  @@unique([organizationId, id])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, contentFingerprint])
  @@map("statements")
}

model Job {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  statementId    String    @map("statement_id") @db.Uuid
  status         JobStatus @default(PENDING)
  idempotencyKey String    @map("idempotency_key") @db.VarChar(128)
  profileVersion String    @map("profile_version") @db.VarChar(32)
  attemptCount   Int       @default(0) @map("attempt_count")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  statement    Statement    @relation(fields: [organizationId, statementId], references: [organizationId, id], onDelete: Cascade)
  attempts     JobAttempt[]

  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, id])
  @@index([organizationId, status, createdAt])
  @@map("jobs")
}

model JobAttempt {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  jobId            String           @map("job_id") @db.Uuid
  attemptNumber    Int              @map("attempt_number")
  status           JobAttemptStatus @default(RUNNING)
  extractorId      String?          @map("extractor_id") @db.VarChar(64)
  extractorVersion String?          @map("extractor_version") @db.VarChar(32)
  errorCode        String?          @map("error_code") @db.VarChar(64)
  rowCount         Int?             @map("row_count")
  movementCount    Int?             @map("movement_count")
  pageCount        Int?             @map("page_count")
  /// Invariantes evaluadas por el worker: [{code, status}], esquema versionado por `checksVersion`.
  checks           Json?
  checksVersion    Int              @default(1) @map("checks_version")
  startedAt        DateTime         @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt       DateTime?        @map("finished_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job          @relation(fields: [organizationId, jobId], references: [organizationId, id], onDelete: Cascade)
  warnings     JobWarning[]
  artifacts    Artifact[]

  @@unique([jobId, attemptNumber])
  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@map("job_attempts")
}

model JobWarning {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  jobAttemptId   String          @map("job_attempt_id") @db.Uuid
  code           String          @db.VarChar(64)
  severity       WarningSeverity @default(WARNING)
  page           Int?
  occurrences    Int             @default(1)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobAttempt   JobAttempt   @relation(fields: [organizationId, jobAttemptId], references: [organizationId, id], onDelete: Cascade)

  @@unique([jobAttemptId, code, page])
  @@index([organizationId, code])
  @@map("job_warnings")
}

model Artifact {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  statementId    String       @map("statement_id") @db.Uuid
  jobAttemptId   String?      @map("job_attempt_id") @db.Uuid
  kind           ArtifactKind
  objectKey      String       @unique @map("object_key") @db.VarChar(255)
  byteSize       Int          @map("byte_size")
  checksum       String       @db.VarChar(64)
  retainUntil    DateTime?    @map("retain_until") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  statement    Statement    @relation(fields: [organizationId, statementId], references: [organizationId, id], onDelete: Cascade)
  // `NoAction` y no `SetNull`: la clave compuesta incluye `organizationId`, que es
  // obligatorio. El borrado real ocurre por cascada desde la organización.
  jobAttempt   JobAttempt?  @relation(fields: [organizationId, jobAttemptId], references: [organizationId, id], onDelete: NoAction)

  @@index([organizationId, statementId, kind])
  @@map("artifacts")
}

model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String   @db.VarChar(64)
  entityType     String   @map("entity_type") @db.VarChar(48)
  entityId       String?  @map("entity_id") @db.Uuid
  requestId      String?  @map("request_id") @db.VarChar(64)
  metadata       Json?
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, occurredAt(sort: Desc)])
  @@map("audit_events")
}

model OutboxEvent {
  id             String    @id @default(uuid()) @db.Uuid
  aggregateType  String    @map("aggregate_type") @db.VarChar(48)
  aggregateId    String    @map("aggregate_id") @db.Uuid
  eventType      String    @map("event_type") @db.VarChar(64)
  payloadVersion Int       @default(1) @map("payload_version")
  payload        Json
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}
