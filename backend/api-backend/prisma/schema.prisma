// Implementa el modelo lógico de `docs/_base_de_datos.md`.
//
// Reglas que este esquema hace cumplir:
// - toda entidad de un tenant lleva `organizationId`, aunque pudiera derivarse;
// - las claves compuestas impiden asociar filas de organizaciones distintas;
// - no existe tabla de movimientos bancarios: el MVP aplica minimización de datos;
// - los importes persistidos usan `Decimal`, nunca coma flotante;
// - de una contraseña solo se guarda su derivación, nunca el valor en claro;
// - la sesión es un token opaco con fila propia, para poder revocarla al instante;
// - roles, permisos, membresías y sus funciones son catálogos, no enums: crecer es
//   insertar filas (ADR-0016).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum MembershipStatus {
  ACTIVE
  REVOKED
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

enum StatementStatus {
  REGISTERED
  UPLOADED
  PROCESSED
  DELETED
}

enum JobStatus {
  PENDING
  UPLOADED
  QUEUED
  PROCESSING
  SUCCEEDED
  NEEDS_REVIEW
  FAILED
}

enum JobAttemptStatus {
  RUNNING
  SUCCEEDED
  NEEDS_REVIEW
  FAILED
}

/// `PENDING`: páginas apartadas para una subida en curso. `COMMITTED`: la subida
/// terminó y su consumo real ya está en `page_consumption_entries`. `RELEASED`: la
/// subida falló o no consumió, y las páginas vuelven a estar libres.
enum PageReservationStatus {
  PENDING
  COMMITTED
  RELEASED
}

/// De dónde sale un lote de páginas (ADR-0019). `TRIAL`: la prueba gratuita, una
/// vez por persona. `MEMBERSHIP_PERIOD`: lo que incluye la membresía en un
/// periodo. `PURCHASE`: una compra de Recargas o Profesional que registró un
/// administrador. `ADJUSTMENT`: un ajuste administrativo con su motivo.
enum PageLotSource {
  TRIAL
  MEMBERSHIP_PERIOD
  PURCHASE
  ADJUSTMENT
}

enum WarningSeverity {
  INFO
  WARNING
  ERROR
}

enum ArtifactKind {
  SOURCE_PDF
  RESULT_XLSX
  RESULT_CSV
  TECHNICAL_MANIFEST
}

model Organization {
  id            String             @id @default(uuid()) @db.Uuid
  displayName   String             @map("display_name") @db.VarChar(160)
  status        OrganizationStatus @default(ACTIVE)
  retentionDays Int                @default(90) @map("retention_days")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships            OrganizationMembership[]
  sessions               Session[]
  apiKeys                ApiKey[]
  statements             Statement[]
  jobs                   Job[]
  attempts               JobAttempt[]
  warnings               JobWarning[]
  artifacts              Artifact[]
  auditEvents            AuditEvent[]
  pageConsumptionEntries PageConsumptionEntry[]
  pageReservations       PageReservation[]
  pageLots               PageLot[]
  personalPayments       PersonalPayment[]

  @@map("organizations")
}

/// Persona que inicia sesión. El correo se guarda normalizado (minúsculas, sin
/// espacios) porque es la clave de acceso y no puede depender de cómo se escriba.
model User {
  id              String     @id @default(uuid()) @db.Uuid
  emailNormalized String     @unique @map("email_normalized") @db.VarChar(320)
  displayName     String     @map("display_name") @db.VarChar(160)
  /// Derivación scrypt con sal, en el formato de `password-hash.ts`. Nunca el valor
  /// en claro. Es opcional porque un usuario recién invitado aún no tiene contraseña.
  passwordHash    String?    @map("password_hash") @db.VarChar(255)
  passwordSetAt   DateTime?  @map("password_set_at") @db.Timestamptz(6)
  status          UserStatus @default(INVITED)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(6)
  /// Intentos fallidos consecutivos y bloqueo temporal: sin esto, la contraseña de
  /// cualquier persona se puede probar sin límite contra un endpoint público.
  failedAttempts  Int        @default(0) @map("failed_attempts")
  lockedUntil     DateTime?  @map("locked_until") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships            OrganizationMembership[]
  statements             Statement[]
  sessions               Session[]
  pageConsumptionEntries PageConsumptionEntry[]
  pageReservations       PageReservation[]
  pageLots               PageLot[]                @relation("PageLotOwner")
  registeredPageLots     PageLot[]                @relation("PageLotRegistrar")

  @@map("users")
}

/// Sesión de navegador. Token opaco y no JWT: así cerrar sesión o desactivar a una
/// persona surte efecto de inmediato, sin esperar a que caduque nada firmado.
/// Solo se almacena el hash del token; el valor viaja en una cookie httpOnly.
model Session {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([organizationId, expiresAt])
  @@map("sessions")
}

/// Pertenencia de una persona a una organización: con qué rol y con qué membresía.
///
/// El rol dice qué puede **administrar**; la membresía (plan), qué parte del
/// producto **usa** y con qué límites. Son independientes: un administrador puede
/// tener cualquier membresía. Ver ADR-0016.
model OrganizationMembership {
  id                         String           @id @default(uuid()) @db.Uuid
  organizationId             String           @map("organization_id") @db.Uuid
  userId                     String           @map("user_id") @db.Uuid
  roleCode                   String           @map("role_code") @db.VarChar(32)
  planCode                   String           @map("plan_code") @db.VarChar(32)
  /// Desde cuándo tiene la membresía actual. Los cambios quedan en `audit_events`.
  planChangedAt              DateTime         @default(now()) @map("plan_changed_at") @db.Timestamptz(6)
  /// Último día de vigencia, en la zona horaria del negocio. Nulo: no vence. Solo
  /// la llevan los roles con `plan_expiry_required`; vencida, no se convierte (ADR-0017).
  planExpiresOn              DateTime?        @map("plan_expires_on") @db.Date
  /// Cuándo consumió la prueba gratuita de un plan `trial_one_time`. Nulo: no la
  /// ha usado. No se reinicia al cambiar de plan y nunca se vuelve a poner en
  /// nulo (ADR-0018).
  trialUsedAt                DateTime?        @map("trial_used_at") @db.Timestamptz(6)
  /// Tope de páginas al mes puesto a mano por un administrador (rango ADMIN
  /// basta, no hace falta SUPER_ADMIN), para una persona concreta por encima
  /// de lo que ya trae su plan Básica o Especial — la "recarga Atlas" que se
  /// cotiza y se cobra por fuera. Nulo: usa el de su plan, sin cambios.
  monthlyPageQuotaOverride   Int?             @map("monthly_page_quota_override")
  /// Desde cuándo se cuentan los periodos mensuales de su membresía (ADR-0019):
  /// la activación del plan actual, o la renovación de uno que ya había vencido.
  /// Renovar antes de que venza no lo mueve: los periodos siguen su cadencia.
  periodAnchorAt             DateTime         @default(now()) @map("period_anchor_at") @db.Timestamptz(6)
  personalRenewalCancelledAt DateTime?        @map("personal_renewal_cancelled_at") @db.Timestamptz(6)
  status                     MembershipStatus @default(ACTIVE)
  createdAt                  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  // `Restrict`: un rol o un plan en uso no se borra del catálogo; se retira.
  role             Role              @relation(fields: [roleCode], references: [code], onDelete: Restrict)
  plan             MembershipPlan    @relation(fields: [planCode], references: [code], onDelete: Restrict)
  personalPayments PersonalPayment[]

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([planCode])
  @@map("organization_memberships")
}

/// Un cobro manual confirmado por un periodo de ATLAS Personal.
model PersonalPayment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  membershipId   String?  @map("membership_id") @db.Uuid
  reference      String   @db.VarChar(100)
  amount         Decimal  @db.Decimal(10, 2)
  currency       String   @db.Char(3)
  pages          Int
  startsOn       DateTime @map("starts_on") @db.Date
  endsOn         DateTime @map("ends_on") @db.Date
  anchorOn       DateTime @map("anchor_on") @db.Date
  recordedAt     DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   OrganizationMembership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  @@unique([organizationId, reference])
  @@unique([membershipId, startsOn])
  @@index([organizationId, recordedAt])
  @@map("personal_payments")
}

/// Rol dentro de una organización. Es un catálogo y no un enum para que añadir un
/// rol sea insertar filas, no migrar un tipo. El código pregunta por **permisos**
/// (`role_permissions`) y por **rango**, nunca por el nombre de un rol (ADR-0016).
model Role {
  code               String   @id @db.VarChar(32)
  name               String   @db.VarChar(80)
  description        String   @db.VarChar(255)
  /// Jerarquía: solo se gestionan cuentas de rango inferior; con el mismo rango,
  /// solo cambios reversibles. Nadie asigna un rol de rango superior al suyo.
  rank               Int      @default(0)
  /// Plan que se propone al dar de alta con este rol. Nulo: hay que elegirlo.
  defaultPlanCode    String?  @map("default_plan_code") @db.VarChar(32)
  /// Si su membresía tiene fecha de vencimiento. Los administradores no vencen.
  planExpiryRequired Boolean  @default(false) @map("plan_expiry_required")
  /// Los roles sembrados por migración no se borran del catálogo.
  isSystem           Boolean  @default(false) @map("is_system")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  defaultPlan MembershipPlan?          @relation("RoleDefaultPlan", fields: [defaultPlanCode], references: [code], onDelete: SetNull)
  permissions RolePermission[]
  memberships OrganizationMembership[]

  @@map("roles")
}

/// Acción administrable que un rol concede. Solo existen las que el código aplica:
/// un permiso sin efecto haría creer que hay una restricción que no hay.
model Permission {
  code        String   @id @db.VarChar(64)
  description String   @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleCode       String @map("role_code") @db.VarChar(32)
  permissionCode String @map("permission_code") @db.VarChar(64)

  role       Role       @relation(fields: [roleCode], references: [code], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([roleCode, permissionCode])
  @@map("role_permissions")
}

/// Tipo de membresía: qué vistas usa una persona y con qué límites. Los límites son
/// columnas y no constantes del código para que un plan nuevo, o un cambio de cupo,
/// sea una fila y no un despliegue.
model MembershipPlan {
  code                String   @id @db.VarChar(32)
  name                String   @db.VarChar(80)
  description         String   @db.VarChar(255)
  /// Tope técnico por PDF: protege al worker de un archivo absurdo. Nulo: sin
  /// tope (no usarlo en catálogos nuevos; se prefiere un número alto, p. ej.
  /// 1000). No es el límite de cobro — ver `monthlyPageQuota` (ADR-0018).
  maxPagesPerDocument Int?     @map("max_pages_per_document")
  /// Páginas acumuladas que admite el plan cada 30 días, sumando todos los PDF
  /// que la persona sube. Esto es lo que decide el cobro. Nulo: sin tope fijo,
  /// se cotiza (hoy solo Atlas). Ver ADR-0018.
  monthlyPageQuota    Int?     @map("monthly_page_quota")
  /// La prueba gratuita se consume una sola vez por persona y no se renueva
  /// cada mes, a diferencia de `monthlyPageQuota` (ADR-0018).
  trialOneTime        Boolean  @default(false) @map("trial_one_time")
  /// Plan de las cuentas nuevas cuando no se indica otro.
  isDefault           Boolean  @default(false) @map("is_default")
  /// Un plan retirado no se ofrece en altas ni cambios; quien lo tiene lo conserva.
  isActive            Boolean  @default(true) @map("is_active")
  sortOrder           Int      @default(0) @map("sort_order")
  /// Precio publicado por periodo (o único, si es de prueba). Nulo: no se vende
  /// por catálogo (planes anteriores o el interno de administración). Informativo:
  /// el cobro sigue siendo manual mientras no haya pasarela (ADR-0019).
  priceAmount         Decimal? @map("price_amount") @db.Decimal(10, 2)
  currency            String   @default("PEN") @db.Char(3)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  features        PlanFeature[]
  memberships     OrganizationMembership[]
  defaultForRoles Role[]                   @relation("RoleDefaultPlan")
  pageLots        PageLot[]

  @@map("membership_plans")
}

/// `PER_PAGE`: se compra la cantidad de páginas que se quiera, desde un mínimo, a
/// un precio por página (ATLAS Recargas). `PACKAGE`: cantidad fija a precio fijo
/// (ATLAS Profesional 500/2000/6000).
enum CommercialPricing {
  PER_PAGE
  PACKAGE
}

/// Producto de saldo: páginas que se compran aparte de la membresía y se suman a
/// ella, con su propia vigencia (ADR-0019). Tabla aparte de `membership_plans`
/// porque no es la identidad de la cuenta: una persona tiene un solo plan, pero
/// puede tener varias compras a la vez, y estas no desbloquean vistas.
model CommercialProduct {
  code         String            @id @db.VarChar(32)
  name         String            @db.VarChar(80)
  description  String            @db.VarChar(255)
  pricing      CommercialPricing
  /// `PACKAGE`: páginas del paquete. `PER_PAGE`: nulo.
  pageQuantity Int?              @map("page_quantity")
  /// `PER_PAGE`: mínimo de páginas por compra. `PACKAGE`: nulo.
  minimumPages Int?              @map("minimum_pages")
  /// `PACKAGE`: precio del paquete. `PER_PAGE`: precio de una página.
  price        Decimal           @db.Decimal(10, 2)
  currency     String            @default("PEN") @db.Char(3)
  /// Días calendario que dura el saldo desde que se registra la compra.
  validityDays Int               @map("validity_days")
  isActive     Boolean           @default(true) @map("is_active")
  sortOrder    Int               @default(0) @map("sort_order")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  pageLots PageLot[]

  @@map("commercial_products")
}

/// Parte del producto que un plan habilita, además de convertir, que tienen todos.
model Feature {
  code        String   @id @db.VarChar(64)
  description String   @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  plans PlanFeature[]

  @@map("features")
}

model PlanFeature {
  planCode    String @map("plan_code") @db.VarChar(32)
  featureCode String @map("feature_code") @db.VarChar(64)

  plan    MembershipPlan @relation(fields: [planCode], references: [code], onDelete: Cascade)
  feature Feature        @relation(fields: [featureCode], references: [code], onDelete: Cascade)

  @@id([planCode, featureCode])
  @@map("plan_features")
}

/// Credencial de servicio con alcance de organización.
/// Solo se guarda el hash; el valor en claro se muestra una vez al crearla.
model ApiKey {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  label          String       @db.VarChar(80)
  tokenHash      String       @unique @map("token_hash") @db.VarChar(64)
  status         ApiKeyStatus @default(ACTIVE)
  lastUsedAt     DateTime?    @map("last_used_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("api_keys")
}

model Statement {
  id                 String          @id @default(uuid()) @db.Uuid
  organizationId     String          @map("organization_id") @db.Uuid
  uploadedById       String?         @map("uploaded_by") @db.Uuid
  contentFingerprint String          @map("content_fingerprint") @db.VarChar(64)
  /// Etiqueta privada para el dueño; nunca se usa como ruta ni se registra.
  sourceFileName     String?         @map("source_file_name") @db.VarChar(255)
  byteSize           Int             @map("byte_size")
  status             StatementStatus @default(REGISTERED)
  bankCode           String?         @map("bank_code") @db.VarChar(32)
  currencyCode       String?         @map("currency_code") @db.Char(3)
  periodStart        DateTime?       @map("period_start") @db.Date
  periodEnd          DateTime?       @map("period_end") @db.Date
  accountAlias       String?         @map("account_alias") @db.VarChar(32)
  retainUntil        DateTime?       @map("retain_until") @db.Timestamptz(6)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization           Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy             User?                  @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  jobs                   Job[]
  artifacts              Artifact[]
  pageConsumptionEntries PageConsumptionEntry[]

  @@unique([organizationId, id])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, contentFingerprint])
  @@index([organizationId, uploadedById])
  @@map("statements")
}

model Job {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  statementId    String    @map("statement_id") @db.Uuid
  status         JobStatus @default(PENDING)
  idempotencyKey String    @map("idempotency_key") @db.VarChar(128)
  profileVersion String    @map("profile_version") @db.VarChar(32)
  attemptCount   Int       @default(0) @map("attempt_count")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  statement    Statement    @relation(fields: [organizationId, statementId], references: [organizationId, id], onDelete: Cascade)
  attempts     JobAttempt[]

  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, id])
  @@index([organizationId, status, createdAt])
  @@map("jobs")
}

model JobAttempt {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  jobId            String           @map("job_id") @db.Uuid
  attemptNumber    Int              @map("attempt_number")
  status           JobAttemptStatus @default(RUNNING)
  extractorId      String?          @map("extractor_id") @db.VarChar(64)
  extractorVersion String?          @map("extractor_version") @db.VarChar(32)
  errorCode        String?          @map("error_code") @db.VarChar(64)
  rowCount         Int?             @map("row_count")
  movementCount    Int?             @map("movement_count")
  pageCount        Int?             @map("page_count")
  /// Invariantes evaluadas por el worker: [{code, status}], esquema versionado por `checksVersion`.
  checks           Json?
  checksVersion    Int              @default(1) @map("checks_version")
  startedAt        DateTime         @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt       DateTime?        @map("finished_at") @db.Timestamptz(6)

  organization           Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job                    Job                    @relation(fields: [organizationId, jobId], references: [organizationId, id], onDelete: Cascade)
  warnings               JobWarning[]
  artifacts              Artifact[]
  pageConsumptionEntries PageConsumptionEntry[]

  @@unique([jobId, attemptNumber])
  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([organizationId, startedAt])
  @@map("job_attempts")
}

/// Cuánto le costó a una persona cada conversión, aparte del historial documental
/// (ADR-0018, anexo de corrección). Es un registro de facturación append-only: la
/// aplicación solo inserta, nunca actualiza ni borra una fila de aquí.
///
/// `jobAttemptId` y `statementId` son `SetNull`, nunca `Cascade`: borrar un
/// documento (por el usuario, por el cupo de documentos, o al borrar la cuenta)
/// no debe borrar lo que ya se cobró por él. `pageCount` y `occurredAt` se copian
/// en el momento de escribir — nunca se vuelven a leer del intento original — así
/// que el acumulado de páginas sigue siendo correcto aunque el intento desaparezca.
model PageConsumptionEntry {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String?          @map("user_id") @db.Uuid
  jobAttemptId   String?          @map("job_attempt_id") @db.Uuid
  statementId    String?          @map("statement_id") @db.Uuid
  /// Copia inmutable de `job_attempts.page_count` al momento de registrar.
  pageCount      Int              @map("page_count")
  /// Copia de `job_attempts.finished_at`: la ventana de 30 días se calcula
  /// contra esta columna, nunca releyendo el intento.
  occurredAt     DateTime         @map("occurred_at") @db.Timestamptz(6)
  countedStatus  JobAttemptStatus @map("counted_status")
  /// Reserva con la que se registró: sus asignaciones dicen de qué lotes salió.
  /// Nula en lo registrado antes de los lotes y en planes sin tope.
  reservationId  String?          @map("reservation_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  jobAttempt   JobAttempt?      @relation(fields: [jobAttemptId], references: [id], onDelete: SetNull)
  statement    Statement?       @relation(fields: [statementId], references: [id], onDelete: SetNull)
  reservation  PageReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  // Un intento no se cuenta dos veces; varias filas con `job_attempt_id` nulo
  // (el intento ya no se puede referenciar) no chocan entre sí.
  @@unique([organizationId, jobAttemptId])
  @@index([organizationId, userId, occurredAt])
  @@map("page_consumption_entries")
}

/// Páginas apartadas para una subida en curso, antes de llamar al worker (ADR-0018,
/// anexo de concurrencia). Sin esto, dos subidas simultáneas de la misma persona
/// leían el mismo acumulado y ambas pasaban aunque juntas excedieran el tope.
///
/// Se crea bajo un lock de aviso por persona, en una transacción corta; mientras
/// está `PENDING` cuenta como usada. Al terminar la subida pasa a `COMMITTED` (su
/// consumo real queda en `page_consumption_entries`) o a `RELEASED`. Una reserva
/// que quedó `PENDING` porque el proceso murió deja de contar pasado un margen
/// mayor que el timeout del worker, así nadie queda bloqueado para siempre.
model PageReservation {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  userId         String?               @map("user_id") @db.Uuid
  /// Techo apartado: lo que se le envía al worker como `max_pages`, no el
  /// número real de páginas, que se conoce al volver del worker.
  pages          Int
  status         PageReservationStatus @default(PENDING)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  settledAt      DateTime?             @map("settled_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  allocations        PageLotAllocation[]
  consumptionEntries PageConsumptionEntry[]

  @@index([organizationId, userId, status, createdAt])
  @@map("page_reservations")
}

/// Lote de páginas: una fuente de saldo con su cantidad y su vencimiento
/// (ADR-0019). Se consume primero el que vence antes (FEFO).
///
/// Un lote no se edita ni se borra desde la aplicación: lo consumido sale de sus
/// asignaciones confirmadas (`page_lot_allocations`) y lo apartado, de las que
/// siguen pendientes. Así no hay contadores que se desincronicen, y una reserva
/// olvidada deja de apartar con el tiempo igual que antes. El precio y el
/// vencimiento se copian al crearlo: cambiar el catálogo no toca lo ya vendido.
model PageLot {
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String        @map("organization_id") @db.Uuid
  userId           String?       @map("user_id") @db.Uuid
  source           PageLotSource
  /// `TRIAL` y `MEMBERSHIP_PERIOD`: el plan del que sale.
  planCode         String?       @map("plan_code") @db.VarChar(32)
  /// `PURCHASE`: el producto comprado.
  productCode      String?       @map("product_code") @db.VarChar(32)
  /// `TRIAL` (`TRIAL`) y `MEMBERSHIP_PERIOD` (`PERIOD:<día de inicio>`): impide
  /// crear dos veces el mismo lote. Nulo en compras y ajustes, que se apilan.
  periodKey        String?       @map("period_key") @db.VarChar(40)
  quantity         Int
  /// Páginas que ya se habían consumido en ese periodo antes de que existieran
  /// los lotes: solo en el primer periodo de cada persona tras la migración, leídas
  /// del registro de consumo, nunca inventadas.
  carriedOverPages Int           @default(0) @map("carried_over_pages")
  startsAt         DateTime      @map("starts_at") @db.Timestamptz(6)
  /// Nulo: no vence (la prueba gratuita).
  expiresAt        DateTime?     @map("expires_at") @db.Timestamptz(6)
  /// `PURCHASE`: lo que se cobró, copiado del catálogo al registrar la compra.
  pricePaid        Decimal?      @map("price_paid") @db.Decimal(10, 2)
  currency         String?       @db.Char(3)
  /// Número de operación de Yape u otra referencia del pago.
  paymentReference String?       @map("payment_reference") @db.VarChar(100)
  /// Motivo de un ajuste, o una nota de quien registró la compra.
  note             String?       @db.VarChar(255)
  registeredById   String?       @map("registered_by_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?               @relation("PageLotOwner", fields: [userId], references: [id], onDelete: SetNull)
  registeredBy User?               @relation("PageLotRegistrar", fields: [registeredById], references: [id], onDelete: SetNull)
  // `Restrict`: un plan o producto con lotes no se borra; se retira.
  plan         MembershipPlan?     @relation(fields: [planCode], references: [code], onDelete: Restrict)
  product      CommercialProduct?  @relation(fields: [productCode], references: [code], onDelete: Restrict)
  allocations  PageLotAllocation[]

  @@unique([organizationId, userId, periodKey])
  @@index([organizationId, userId, expiresAt])
  @@map("page_lots")
}

/// Cuánto de una reserva sale de cada lote. Al reservar se reparte el techo en
/// orden FEFO; al confirmar la subida se fija cuánto se consumió de verdad de
/// cada uno, también en orden FEFO. Una reserva liberada deja sus asignaciones
/// sin consumo.
model PageLotAllocation {
  id            String @id @default(uuid()) @db.Uuid
  reservationId String @map("reservation_id") @db.Uuid
  lotId         String @map("lot_id") @db.Uuid
  reservedPages Int    @map("reserved_pages")
  /// Nulo mientras la reserva no se confirma.
  consumedPages Int?   @map("consumed_pages")

  reservation PageReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  // `NoAction` y no `Restrict`: al borrar una organización, lotes y reservas caen
  // en la misma sentencia y la comprobación debe esperar al final de ella.
  lot         PageLot         @relation(fields: [lotId], references: [id], onDelete: NoAction)

  @@unique([reservationId, lotId])
  @@index([lotId])
  @@map("page_lot_allocations")
}

model JobWarning {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  jobAttemptId   String          @map("job_attempt_id") @db.Uuid
  code           String          @db.VarChar(64)
  severity       WarningSeverity @default(WARNING)
  page           Int?
  occurrences    Int             @default(1)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobAttempt   JobAttempt   @relation(fields: [organizationId, jobAttemptId], references: [organizationId, id], onDelete: Cascade)

  @@unique([jobAttemptId, code, page])
  @@index([organizationId, code])
  @@map("job_warnings")
}

model Artifact {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  statementId    String       @map("statement_id") @db.Uuid
  jobAttemptId   String?      @map("job_attempt_id") @db.Uuid
  kind           ArtifactKind
  objectKey      String       @unique @map("object_key") @db.VarChar(255)
  byteSize       Int          @map("byte_size")
  checksum       String       @db.VarChar(64)
  retainUntil    DateTime?    @map("retain_until") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  statement    Statement    @relation(fields: [organizationId, statementId], references: [organizationId, id], onDelete: Cascade)
  // `NoAction` y no `SetNull`: la clave compuesta incluye `organizationId`, que es
  // obligatorio. El borrado real ocurre por cascada desde la organización.
  jobAttempt   JobAttempt?  @relation(fields: [organizationId, jobAttemptId], references: [organizationId, id], onDelete: NoAction)

  @@index([organizationId, statementId, kind])
  @@map("artifacts")
}

model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String   @db.VarChar(64)
  entityType     String   @map("entity_type") @db.VarChar(48)
  entityId       String?  @map("entity_id") @db.Uuid
  requestId      String?  @map("request_id") @db.VarChar(64)
  metadata       Json?
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, occurredAt(sort: Desc)])
  @@map("audit_events")
}

model OutboxEvent {
  id             String    @id @default(uuid()) @db.Uuid
  aggregateType  String    @map("aggregate_type") @db.VarChar(48)
  aggregateId    String    @map("aggregate_id") @db.Uuid
  eventType      String    @map("event_type") @db.VarChar(64)
  payloadVersion Int       @default(1) @map("payload_version")
  payload        Json
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}
