# Copia este archivo como `.env`. `.env` no se versiona.
# Ningún secreto real debe escribirse aquí.

NODE_ENV=development
PORT=3000

# Dónde vive el estado de los trabajos.
#   database -> PostgreSQL y almacenamiento de objetos (modo del producto).
#   memory   -> nada se escribe en disco y todo se pierde al reiniciar.
# En `memory` no se exigen DATABASE_URL ni FINGERPRINT_SECRET, pero sí EPHEMERAL_API_KEY.
PERSISTENCE_MODE=database

# PostgreSQL administrado por esta aplicación (ver docker-compose.yml en la raíz).
DATABASE_URL=postgresql://eecc:cambia-esta-clave-local@127.0.0.1:5432/eecc

# API interna del worker Python.
WORKER_BASE_URL=http://127.0.0.1:8000
WORKER_TIMEOUT_MS=120000

# Límite de carga en bytes.
MAX_UPLOAD_BYTES=52428800

# Clave HMAC del fingerprint por organización. En despliegue vive en el gestor de secretos.
FINGERPRINT_SECRET=genera-una-clave-local-de-al-menos-32-caracteres

# Raíz del almacenamiento de objetos mientras no se conecta S3.
STORAGE_ROOT=storage

# Versión del perfil de extracción usada en la clave de idempotencia.
PROFILE_VERSION=bcp-2026.08

# Solo para PERSISTENCE_MODE=memory, donde no hay tabla de credenciales.
# Es la única credencial aceptada: 32-128 caracteres de [A-Za-z0-9._-].
EPHEMERAL_API_KEY=genera-una-credencial-local-de-al-menos-32-caracteres
# Organización a la que se atribuyen los trabajos sin persistencia.
EPHEMERAL_ORGANIZATION_ID=00000000-0000-4000-8000-000000000000
# Cupo y caducidad del historial en memoria: acotan cuánto se retiene en RAM.
EPHEMERAL_MAX_JOBS=25
EPHEMERAL_TTL_MINUTES=60

# Orígenes del navegador autorizados, separados por coma. Vacío desactiva CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5199,http://127.0.0.1:5199
