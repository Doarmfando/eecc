# Copia este archivo como `.env.local`. No se versiona.
# Solo variables con prefijo `VITE_` llegan al navegador: nunca pongas secretos aquí.

# Origen de la API. Vacío = el mismo que la página, que es lo recomendado: el proxy
# de Vite reenvía `/v1` al backend y así la cookie de sesión viaja sin CORS.
VITE_API_BASE_URL=

# A dónde reenvía el proxy de desarrollo. Debe coincidir con el puerto de la API.
VITE_API_PROXY_TARGET=http://127.0.0.1:3000
