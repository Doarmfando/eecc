{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/v1/:path*", "destination": "https://eecc-api-production.up.railway.app/v1/:path*" },
    { "source": "/health", "destination": "https://eecc-api-production.up.railway.app/health" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
