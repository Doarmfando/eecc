# Copia este archivo como `.env` y ajusta los valores locales.
# `.env` no se versiona. Los valores de ejemplo son ficticios y solo sirven en desarrollo.

# PostgreSQL local (Docker Compose)
POSTGRES_DB=eecc
POSTGRES_USER=eecc
POSTGRES_PASSWORD=cambia-esta-clave-local
POSTGRES_PORT=5432

# Redis local (cola interna del worker)
REDIS_PORT=6379

# MinIO local (almacenamiento S3-compatible)
MINIO_ROOT_USER=eecc-local
MINIO_ROOT_PASSWORD=cambia-esta-clave-local
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
